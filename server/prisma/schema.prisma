generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed password
  createdAt DateTime @default(now())
  
  // Relations: Pointing to the join table and messages
  conversations ConversationParticipant[]
  messages      Message[]
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // ✅ REQUIRED FIELDS FOR GROUP CHAT
  name      String?  // Nullable: "Tech Team" has a name, but 1:1 chat is just null
  isGroup   Boolean  @default(false) // Distinguishes between Direct Messages and Groups

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  joinedAt       DateTime     @default(now())
  
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId]) // Prevents a user from being added twice to the same chat
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  createdAt      DateTime     @default(now())
  
  // Sender relation
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  
  // Conversation relation
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt]) // optimises fetching chat history
}